# ==============================================================================
# The Forwarded Seal — Backend Environment Configuration (Phases 1 - 7)
# ==============================================================================

# Application Settings
PROJECT_NAME="The Forwarded Seal"
ENVIRONMENT="development"  # Options: "development", "staging", "production", "testing"
DEBUG=False
API_V1_PREFIX="/api"

# Development demo administrator (disabled automatically in production)
AUTO_CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL="admin@gmu.edu"
DEFAULT_ADMIN_PASSWORD="Gmu@12345!"
DEFAULT_ADMIN_NAME="University Registrar"
DEFAULT_ADMIN_ROLE="institutional_admin"

# Security & Authentication (JWT)
# Generate a secure 64-char random hex string in production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="insecure-dev-secret-key-change-this-in-production-neuroforce-phase2"
SECRET_KEY="insecure-dev-secret-key-change-this-in-production-neuroforce-phase2"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Protected Admin Registration Secret
# Safeguards POST /api/admin/register from unauthorized registration
ADMIN_REGISTRATION_SECRET="seal-admin-bootstrap-secret-change-in-prod"

# Database Configuration
# Default development: Local SQLite database
DATABASE_URL="sqlite:///./forwarded_seal.db"
# Supabase PostgreSQL Connection Example:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Cryptographic Key Storage & Ed25519 Management
KEYS_DIR="keys"
ACTIVE_KEY_ID="key-GMU-2026-v1-ed25519"

# Notice Publishing & Distribution Copy Paths
PUBLISHED_DIR="published"
PUBLIC_VERIFICATION_BASE_URL="http://localhost:5173/verify"

# Storage Configuration
# Options: "local" (default) or "supabase"
STORAGE_PROVIDER="local"
STORAGE_BACKEND="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB max document file size

# Notice ID Configuration
# Standard format: FS-{INSTITUTION}-{YEAR}-{CODE} (e.g. FS-GMU-2026-A8F29C)
NOTICE_ID_PREFIX="FS"
INSTITUTION_CODE="GMU"

# CORS Configuration (JSON array or comma-separated list of origins)
ALLOWED_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# Supabase Storage & Database Integration (Optional Cloud Backend)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_NAME="notices"

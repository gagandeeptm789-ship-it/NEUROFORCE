# ==============================================================================
# The Forwarded Seal — Backend Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="The Forwarded Seal"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# Development demo administrator. Automatic creation is disabled outside development
# unless explicitly enabled; never use these credentials in production.
AUTO_CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL="admin@gmu.edu"
DEFAULT_ADMIN_PASSWORD="Gmu@12345!"
DEFAULT_ADMIN_NAME="University Registrar"
DEFAULT_ADMIN_ROLE="institutional_admin"

# Security & Authentication
# IMPORTANT: Generate a secure 64-char random hex string in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="insecure-dev-secret-key-change-this-in-production-neuroforce-phase2"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Protected Admin Registration Secret
# Used to safeguard POST /api/admin/register from unauthorized public access
ADMIN_REGISTRATION_SECRET="seal-admin-bootstrap-secret-change-in-prod"

# Database Configuration
# Default development: SQLite (works out of the box with zero external dependencies)
# Production / Supabase PostgreSQL example:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="sqlite:///./forwarded_seal.db"

# Storage Configuration
# Options: "local" (default) or "supabase" (Phase 2 abstract, Phase 3 ready)
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB in bytes

# Notice ID Configuration
# Example generated format: FS-GMU-2026-A8F29C
NOTICE_ID_PREFIX="FS"
INSTITUTION_CODE="GMU"

# CORS Configuration (comma-separated list of origins for React frontend)
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Supabase Storage Credentials (Optional / Future integration)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET_NAME="notices"
